<Window x:Class="ScreenTimeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:ScreenTimeTracker.ViewModels"
        mc:Ignorable="d"
        Title="Screen Time Tracker"
        Icon="Assets/app_icon.ico"
        Height="800" Width="1160"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI, Inter, -apple-system, Sans-Serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="36,28,36,28">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Live Active Window Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 4 Summary Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Table & Filter Header -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Activities List -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER (Spacious, Geometric, Bold Title & Date Navigation) -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title -->
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="◷" FontSize="26" Margin="0,0,12,0" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                    <TextBlock Text="Screen Time Tracker" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Center Date Navigator (Flat Geometric Strip) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Anterior Button -->
                <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding PreviousDayCommand}" ToolTip="Voir le jour précédent" Padding="10,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◀" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Précédent" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Current Date Display + Context Badge -->
                <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="14,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅" FontSize="13" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentDateFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <!-- Badge: HOY / AYER / HACE X DÍAS -->
                        <Border Background="#18181B" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DateNavigationLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Siguiente Button -->
                <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding NextDayCommand}" IsEnabled="{Binding CanGoToNextDay}" ToolTip="Passer au jour suivant" Padding="10,6" Margin="8,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Suivant" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="▶" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Volver a Hoy Button (Visible si se está viendo un día pasado) -->
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GoToTodayCommand}"
                        Visibility="{Binding CanGoToNextDay, Converter={StaticResource BoolToVisConverter}}"
                        ToolTip="Revenir à aujourd'hui en direct" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◷" FontSize="12" Foreground="#0C0F17" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Aujourd'hui" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Status & Action Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Live / History Status Indicator (Flat 1px Border) -->
                <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="14,8" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrushAccent}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ViewModeBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Settings Button (Flat Geometric) -->
                <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding ToggleSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" Margin="0,0,8,0" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Paramètres" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. LIVE ACTIVE WINDOW BANNER (Flat Strip, CornerRadius=0) -->
        <Border Grid.Row="1" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="20,12" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AU PREMIER PLAN :" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ActiveCategoryIcon}" FontSize="13" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ActiveAppText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Catégorie : " FontSize="12" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                    <Border Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="10,3" Margin="6,0,0,0">
                        <TextBlock Text="{Binding ActiveCategory}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. SUMMARY CARDS (Flat 1px Borders, Spacious, Single Turquoise Accent) -->
        <Grid Grid.Row="2" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 0: Total General -->
            <Border Grid.Column="0" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="22,20" Cursor="Hand" ToolTip="Cliquez pour voir le graphique hebdomadaire du temps total (Lun - Dim)">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenChartCommand}" CommandParameter="Total"/>
                </Border.InputBindings>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="⏱" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DateNavigationLabel, StringFormat='{}TEMPS TOTAL {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalScreenTime}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
                    <TextBlock Text="Voir le détail de la semaine (Lun - Dim) →" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>
            </Border>

            <!-- Card 1: Juegos -->
            <Border Grid.Column="2" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="22,20" Cursor="Hand" ToolTip="Cliquez pour voir le graphique hebdomadaire des Jeux (Lun - Dim)">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenChartCommand}" CommandParameter="Juegos"/>
                </Border.InputBindings>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" FontSize="14" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="JEUX" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" Text="{Binding GamingPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                    </Grid>
                    <TextBlock Text="{Binding GamingTime}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                    <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding GamingPercent}" Maximum="100" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TopGame}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Apps de Escritorio -->
            <Border Grid.Column="4" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="22,20" Cursor="Hand" ToolTip="Cliquez pour voir le graphique hebdomadaire du Bureau (Lun - Dim)">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenChartCommand}" CommandParameter="Aplicaciones de Escritorio"/>
                </Border.InputBindings>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="14" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BUREAU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" Text="{Binding DesktopPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                    </Grid>
                    <TextBlock Text="{Binding DesktopTime}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                    <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding DesktopPercent}" Maximum="100" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TopDesktopApp}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Navegación Web -->
            <Border Grid.Column="6" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="22,20" Cursor="Hand" ToolTip="Cliquez pour voir le graphique hebdomadaire de la Navigation Web (Lun - Dim)">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenChartCommand}" CommandParameter="Navegación Web"/>
                </Border.InputBindings>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☁" FontSize="14" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="NAVIGATION WEB" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" Text="{Binding WebPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                    </Grid>
                    <TextBlock Text="{Binding WebTime}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                    <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding WebPercent}" Maximum="100" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TopWebDomain}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. TABLE FILTERS & CONTROLS -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Buttons (Geometric Segments, CornerRadius=0) -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DateNavigationLabel, StringFormat='{}Détail — {0} :'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,18,0"/>

                <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource FilterButtonStyle}" Content="Toutes" Command="{Binding SetFilterCommand}" CommandParameter="Todas"/>
                        <Border Width="1" Background="{StaticResource BrushCardBorder}"/>
                        <Button Style="{StaticResource FilterButtonStyle}" Content="🎮  Jeux" Command="{Binding SetFilterCommand}" CommandParameter="Juegos"/>
                        <Border Width="1" Background="{StaticResource BrushCardBorder}"/>
                        <Button Style="{StaticResource FilterButtonStyle}" Content="📁  Apps" Command="{Binding SetFilterCommand}" CommandParameter="Aplicaciones de Escritorio"/>
                        <Border Width="1" Background="{StaticResource BrushCardBorder}"/>
                        <Button Style="{StaticResource FilterButtonStyle}" Content="☁  Web" Command="{Binding SetFilterCommand}" CommandParameter="Navegación Web"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Mis à jour toutes les 5 s" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 5. ACTIVITIES LIST / TABLE (Catalog Grid Style, CornerRadius=0) -->
        <Border Grid.Row="4" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0">
            <Grid>
                <!-- Empty State Message -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasNoActivities, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,50,0,50">
                    <TextBlock Text="◷" FontSize="36" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Aucune activité enregistrée à cette date pour l'instant" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Les applications que vous utilisez apparaîtront ici automatiquement toutes les 5 secondes." FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- List of Items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DisplayActivities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:ActivityDisplayItem}">
                                <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="18,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Monochrome Outline Icon -->
                                        <TextBlock Grid.Column="0" Text="{Binding CategoryIcon}" FontSize="14" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <!-- Name & Window Title -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Detail}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding WindowTitle}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Category Badge (Flat, Minimal) -->
                                        <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="8,3">
                                            <TextBlock Text="{Binding CategoryDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Border>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="3" Text="{Binding FormattedDuration}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>

                                        <!-- Proportion / Share Bar (Turquoise Accent) -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding PercentageOfTotal, StringFormat='{}{0:F1} % du total'}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" Margin="0,0,0,3"/>
                                            <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding PercentageOfTotal}" Maximum="100"/>
                                        </StackPanel>

                                        <!-- Last Active -->
                                        <TextBlock Grid.Column="5" Text="{Binding LastActiveText}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 6. SETTINGS OVERLAY FOR GENERAL & GAME DIRECTORIES (Flat, CornerRadius=0) -->
        <Grid Grid.Row="0" Grid.RowSpan="5"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#D90C0C0E">
            <Border Width="680" MinHeight="500" MaxHeight="680"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Title & Close -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Tabs -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Tab Content -->
                        <RowDefinition Height="*"/>
                        <!-- Row 3: Footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="18" Margin="0,0,10,0" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Paramètres" FontSize="19" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Préférences système et bibliothèques de détection" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="28,3,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ModernButtonStyle}" Content="✕" Command="{Binding ToggleSettingsCommand}" Padding="10,6" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Tab Switcher (Flat Segments, CornerRadius=0) -->
                    <Border Grid.Row="1" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Margin="0,0,0,22">
                        <UniformGrid Rows="1" Columns="2">
                            <!-- Tab General -->
                            <Button Content="General" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="General">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGeneralTabSelected}" Value="True">
                                                <Setter Property="Background" Value="#18181B"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Tab Juegos -->
                            <Button Content="Bibliothèques de jeux" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Juegos">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGamesTabSelected}" Value="True">
                                                <Setter Property="Background" Value="#18181B"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- TAB CONTENT AREA -->
                    <!-- 1. GENERAL TAB -->
                    <StackPanel Grid.Row="2" Visibility="{Binding IsGeneralTabSelected, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,18">
                        <!-- Auto-start Windows Toggle Card (Flat) -->
                        <Border Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="20,18" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Lancer au démarrage de Windows" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Lance automatiquement Screen Time Tracker en arrière-plan à l'ouverture de session sur votre PC."
                                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitchStyle}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Background="#18181B" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="12,10" Margin="0,14,0,0">
                                    <TextBlock Text="Configuré dans le Registre Windows (HKCU\Software\Microsoft\Windows\CurrentVersion\Run), de façon sûre et sans droits administrateur."
                                               FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- System Information Cards (Flat) -->
                        <Border Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="Informations système" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Intervalle de relevé :" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="Toutes les 5 secondes" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Stockage :" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="data/screen_time_YYYY-MM-DD.json" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Confidentialité :" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="100 % local et hors ligne" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Détection Web :" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="Multi-navigateur (Chrome, Edge, Brave, Firefox, etc.)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Auteur :" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="Marcos Rieznik" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Licence :" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="GNU General Public License v3.0 (GPLv3)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. GAME DIRECTORIES TAB (Flat) -->
                    <Grid Grid.Row="2" Visibility="{Binding IsGamesTabSelected, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Description & Input -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Les processus actifs lancés depuis ces dossiers seront automatiquement détectés comme « Jeux » (Steam, Epic, Battle.net, etc.). Inutile d'enregistrer chaque exécutable individuellement."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"/>

                            <!-- Add Directory Input -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding NewDirectoryInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Exemple : D:\Jeux\SteamLibrary\steamapps\common"/>
                                <Button Grid.Column="2" Style="{StaticResource ModernButtonStyle}" Content="Parcourir..." Command="{Binding BrowseDirectoryCommand}"/>
                                <Button Grid.Column="4" Style="{StaticResource PrimaryButtonStyle}" Content="Ajouter le dossier" Command="{Binding AddDirectoryCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Directories List (Flat) -->
                        <Border Grid.Row="1" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="8" MaxHeight="270">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GameDirectories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18181B" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="12,8" Margin="0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🎮" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            Content="Supprimer"
                                                            FontSize="11"
                                                            Padding="8,3"
                                                            Command="{Binding DataContext.RemoveDirectoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Développé par Marcos Rieznik" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="Licence GNU General Public License v3.0 (GPLv3)" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource ModernButtonStyle}" Content="Fermer" HorizontalAlignment="Right" Command="{Binding ToggleSettingsCommand}" Width="100"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 7. WEEKLY BAR CHART MODAL OVERLAY (Flat, Geometric, CornerRadius=0) -->
        <Grid Grid.Row="0" Grid.RowSpan="5"
              Visibility="{Binding IsChartOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#D90C0C0E">
            <Border Width="880"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="32,26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Title & Close -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Week Navigation Strip -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Category Filter Segmented Pills -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 3: KPI Strip -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 4: Bar Chart Area -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 5: Footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Close Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title + Icon -->
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ChartIcon}" FontSize="20" Margin="0,0,10,0" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ChartTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Historique hebdomadaire et répartition du temps d'écran" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="30,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource ModernButtonStyle}" Content="✕" Command="{Binding CloseChartCommand}" Padding="10,6" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 1: Week Navigation Strip (Flat Scandinavian, CornerRadius=0) -->
                    <Border Grid.Row="1" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="14,10" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Previous Week Button -->
                            <Button Grid.Column="0"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding PreviousWeekCommand}"
                                    Padding="12,6"
                                    ToolTip="Voir la semaine précédente">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◀" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Semaine précédente" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Center Date Display + Context Badge -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ChartSubtitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                <Border Background="#18181B" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ChartWeekRelativeLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                                </Border>
                            </StackPanel>

                            <!-- Next Week and 'Esta Semana' Jump Button -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ModernButtonStyle}"
                                        Command="{Binding CurrentWeekCommand}"
                                        Visibility="{Binding CanGoToCurrentWeek, Converter={StaticResource BoolToVisConverter}}"
                                        Padding="10,6"
                                        Margin="0,0,8,0"
                                        ToolTip="Revenir à la semaine en cours">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◷" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cette semaine" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ModernButtonStyle}"
                                        Command="{Binding NextWeekCommand}"
                                        IsEnabled="{Binding CanGoToNextWeek}"
                                        Padding="12,6"
                                        ToolTip="Passer à la semaine suivante">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Suivant" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="▶" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Category Filter Segmented Strip (CornerRadius=0) -->
                    <Border Grid.Row="2" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Margin="0,0,0,22">
                        <UniformGrid Rows="1" Columns="4">
                            <!-- 1. VOLVER A TODO -->
                            <Button Content="⏱  Tout" Command="{Binding SwitchChartCategoryCommand}" CommandParameter="Total">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChartTotalSelected}" Value="True">
                                                <Setter Property="Background" Value="#18181B"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 2. JUEGOS -->
                            <Button Content="🎮  Jeux" Command="{Binding SwitchChartCategoryCommand}" CommandParameter="Juegos">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChartGamingSelected}" Value="True">
                                                <Setter Property="Background" Value="#18181B"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 3. ESCRITORIO -->
                            <Button Content="📁  Bureau" Command="{Binding SwitchChartCategoryCommand}" CommandParameter="Aplicaciones de Escritorio">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChartDesktopSelected}" Value="True">
                                                <Setter Property="Background" Value="#18181B"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 4. WEB -->
                            <Button Content="☁  Web" Command="{Binding SwitchChartCategoryCommand}" CommandParameter="Navegación Web">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChartWebSelected}" Value="True">
                                                <Setter Property="Background" Value="#18181B"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- KPI Summary Strip (Flat, CornerRadius=0) -->
                    <Grid Grid.Row="3" Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="TOTAL DE LA SEMAINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding WeekTotalFormatted}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="MOYENNE QUOTIDIENNE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding WeekAverageFormatted}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="JOUR LE PLUS ACTIF" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding WeekPeakDay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bar Chart Area (Flat Pillars, CornerRadius=0) -->
                    <Border Grid.Row="4" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="24,24,24,18" Margin="0,0,0,22">
                        <ItemsControl ItemsSource="{Binding WeekBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,0" VerticalAlignment="Bottom" Cursor="Hand" ToolTip="Cliquez pour voir le détail de ce jour">
                                        <Grid.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectDayFromChartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="190"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Value on top of bar -->
                                        <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8"
                                                Background="#18181B" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="8,3">
                                            <TextBlock Text="{Binding HoursLabel}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center"
                                                       ToolTip="{Binding FormattedTime}"/>
                                        </Border>

                                        <!-- The Vertical Bar Container (Flat, CornerRadius=0) -->
                                        <Grid Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                            <!-- Baseline empty background pillar -->
                                            <Border Width="52" Height="190" Background="#1E1E24" CornerRadius="0"/>

                                            <!-- Filled Bar (Turquoise Accent) -->
                                            <Border Width="52"
                                                    Height="{Binding BarHeight}"
                                                    Background="{StaticResource BrushAccent}"
                                                    CornerRadius="0"
                                                    VerticalAlignment="Bottom"
                                                    ToolTip="{Binding FormattedTime}"/>
                                        </Grid>

                                        <!-- Day Labels on Bottom -->
                                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding DayShort}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DateString}" FontSize="10"
                                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                            <!-- TODAY Badge (Flat) -->
                                            <Border Background="{StaticResource BrushAccent}" CornerRadius="0" Padding="6,2" Margin="0,4,0,0"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding IsToday, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="AUJ." FontSize="9" FontWeight="Bold" Foreground="#121214"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Footer -->
                    <Button Grid.Row="5" Style="{StaticResource ModernButtonStyle}" Content="Fermer" HorizontalAlignment="Right" Command="{Binding CloseChartCommand}" Width="100"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
